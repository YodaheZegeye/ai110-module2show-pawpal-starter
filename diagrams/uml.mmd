classDiagram
    class Pet {
        +str name
        +str species
        +str energy_level
        +List~str~ preferences
        +List~Task~ tasks
        +add_task(task: Task) void
        +get_summary() str
        +add_preference(pref: str) void
    }

    class Owner {
        +str name
        +int available_time_minutes
        +List~Pet~ pets
        +add_pet(pet: Pet) void
        +set_available_time(minutes: int) void
        +get_available_time() int
        +get_all_tasks() List~Task~
    }

    class Task {
        +str title
        +str category
        +int duration_minutes
        +str priority
        +bool is_mandatory
        +str preferred_time
        +str pet_name
        +str frequency
        +bool completed
        +get_priority_score() int
        +mark_completed() void
        +to_dict() dict
    }

    class Schedule {
        +str owner_name
        +Pet pet
        +int available_time_minutes
        +List~dict~ scheduled_tasks
        +List~dict~ unscheduled_tasks
        +int total_duration_minutes
        +List~str~ reasoning
        +remaining_time_minutes int
        +add_scheduled_task(task: Task, time_slot: str, reason: str) void
        +add_unscheduled_task(task: Task, reason: str) void
        +get_formatted_plan() str
    }

    class Scheduler {
        +str strategy
        +generate_plan(owner: Owner, tasks: List~Task~, available_time_minutes: int, pet: Pet, start_time: str) Schedule
        +sort_by_time(tasks: List~Task~) List~Task~
        +filter_tasks(tasks: List~Task~, completed: bool, pet_name: str) List~Task~
        -sort_tasks(tasks: List~Task~) List~Task~
        -evaluate_fit(task: Task, remaining_time: int) tuple
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Scheduler ..> Owner : reads get_all_tasks
    Scheduler ..> Schedule : creates
    Scheduler ..> Task : schedules
    Schedule "1" --> "0..*" Task : includes
    Schedule --> "0..1" Pet : plans for
