classDiagram
    class Pet {
        +str name
        +str species
        +str energy_level
        +List~str~ preferences
        +get_summary() str
        +add_preference(pref: str) void
    }

    class Owner {
        +str name
        +int available_time_minutes
        +List~Pet~ pets
        +add_pet(pet: Pet) void
        +set_available_time(minutes: int) void
        +get_available_time() int
    }

    class Task {
        +str title
        +str category
        +int duration_minutes
        +str priority
        +bool is_mandatory
        +str preferred_time
        +get_priority_score() int
        +to_dict() dict
    }

    class Schedule {
        +Pet pet
        +List~Task~ scheduled_tasks
        +List~Task~ unscheduled_tasks
        +int total_duration_minutes
        +List~str~ reasoning
        +add_scheduled_task(task: Task, time_slot: str, reason: str) void
        +add_unscheduled_task(task: Task, reason: str) void
        +get_formatted_plan() str
    }

    class Scheduler {
        +str strategy
        +generate_plan(tasks: List~Task~, available_time_minutes: int, pet: Pet) Schedule
        -sort_tasks(tasks: List~Task~) List~Task~
        -evaluate_fit(task: Task, remaining_time: int) tuple
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Scheduler ..> Schedule : creates
    Scheduler ..> Task : schedules
    Schedule "1" --> "0..*" Task : includes
    Schedule --> "1" Pet : plans for
